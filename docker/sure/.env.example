# Copy to .env and fill secrets before: docker compose up -d
# Docs: https://docs.sure.am/self-hosting

SELF_HOSTED=true
ONBOARDING_STATE=invite_only

# openssl rand -hex 64
SECRET_KEY_BASE=replace-me

POSTGRES_USER=sure_user
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=sure_production

PORT=3000
SURE_IMAGE_TAG=stable

# Free market data (no API key)
EXCHANGE_RATE_PROVIDER=yahoo_finance
SECURITIES_PROVIDER=yahoo_finance

# Backups → $HOME/backups (Mac: /Users/tuildes/backups, Linux: /home/tuildes/backups)
# Leave BACKUP_DIR unset to use $HOME/backups from compose.
BACKUP_SCHEDULE=0 2 * * *
BACKUP_KEEP_DAYS=14
INSTANCE_ID=home
