[user]
	email = frehse@tuildes.dev
	name = tuildes
	signingKey = ~/.ssh/id_ed25519.pub
[fetch]
	prune = true
[merge]
	conflictstyle = zdiff3
[alias]
	st = status -sb
	lg = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %s %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)' --all
[pull]
	rebase = true
[core]
	editor = nvim
	excludesfile = ~/DotFiles/config/.gitignore_global
	autocrlf = input
	pager = delta
[column]
	ui = auto
[branch]
	sort = -committerdate
[init]
	defaultBranch = develop
[diff]
	renames = true
	algorithm = histogram
[commit]
	template = ~/DotFiles/config/.gitmessage.txt
	gpgSign = true
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
[push]
	autoSetupRemote = true
[interactive]
	diffFilter = delta --color-only
[delta]
	side-by-side = true
