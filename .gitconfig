[user]
	email = frehsegustavo@gmail.com
	name = tuildes
	signingKey = /Users/tuildes/.ssh/id_ed25519.pub
[fetch]
	prune = true
[merge]
	conflictstyle = zdiff3
[alias]
	st = status -sb
	lg = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %s %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)' --all
[pull]
	rebase = true
[core]
	editor = vim
	excludesfile = /Users/tuildes/DotFiles/config/.gitignore_global
[column]
	ui = auto
[branch]
	sort = -committerdate
[init]
	defaultBranch = develop
[diff]
	renames = true
	algorithm = histogram
[commit]
	template = /Users/tuildes/DotFiles/config/.gitmessage.txt
	gpgSign = true
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = /Users/tuildes/.ssh/allowed_signers
